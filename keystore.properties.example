# Copy to `keystore.properties` (untracked) and fill in.
#
# Generate the key ONCE, then back the .jks file and these passwords up
# somewhere that survives this laptop. Every future update of FlowVan must be
# signed with this exact key or it cannot install over the one already on the
# handsets.
#
#   keytool -genkeypair -v \
#     -keystore flowvan-release.jks \
#     -alias flowvan \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -dname "CN=FlowVan, O=7Software, C=JO"
#
storeFile=flowvan-release.jks
storePassword=
keyAlias=flowvan
keyPassword=
